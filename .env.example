APP_NAME=AVC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://applyvipconseil.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avc_database
DB_USERNAME=avc_user
DB_PASSWORD=avc_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Use s3 in production so Storage::url() resolves to N0C. Keep public for pure local-only work.
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_PRIMARY="info@applyvipconseil.com"
MAIL_ADMIN_CC=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ht2-storage
AWS_BUCKET=
AWS_ENDPOINT=https://ht2-storage.n0c.com:5443
AWS_USE_PATH_STYLE_ENDPOINT=true
# Public URL base for Storage::disk('s3')->url().
# N0C reverse proxy is already scoped to the bucket's public/ prefix — do not append /public.
# Requires App\Filesystem\N0cAwsS3V3Adapter (strips public/ from object keys).
AWS_URL=https://applyvipconseil.com/n0c-storage
# Object key prefix inside the bucket. Must stay under public/ for N0C public reads.
AWS_ROOT=public/avc-institute
# Prefix for asset() and @vite. Must include the AWS_ROOT segment AFTER public/
# (proxy maps /n0c-storage → bucket public/, so assets live under …/avc-institute/…).
ASSET_URL=https://applyvipconseil.com/n0c-storage/avc-institute

VITE_APP_NAME="${APP_NAME}"


# GDPR / Privacy Localization Settings
# Set to false to avoid unconsented third-party external IP lookups (GDPR Chapter V compliance)
LOCALE_IP_DETECTION=false
LOCALE_FALLBACK=fa
